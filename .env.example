# Copy to .env and fill in. .env is git-ignored: never commit the real key.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Wix API key with Wix Data and Media Manager permissions (required for the Studio to save).
WIX_API_KEY=

# The Ngwisa Wix site.
WIX_SITE_ID=613b5fe3-6f29-414b-80fc-abe05f934d56

# Site-member ids allowed to use the Studio, comma-separated.
STUDIO_OWNER_IDS=84062810-740a-4954-aac6-a5e0ae7f9dc2

# Public address of the site, for canonical links, the sitemap and share previews (optional).
SITE_URL=

# Origins allowed to call /api/studio from another host (the Wix-hosted site), comma-separated (optional).
STUDIO_ORIGINS=https://ngwisa-gong-gallery-sjkgracee-1309.wix-site-host.com

# Port for server.js when hosting outside Vercel.
PORT=3000
